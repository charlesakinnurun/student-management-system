# --- Database ---
# Dev default (SQLite, zero-config). Prod: postgres, e.g. postgresql://user:pass@host:5432/sms?schema=public
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="dev-only-change-me-min-32-chars-000000000000"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# --- App ---
NEXT_PUBLIC_APP_NAME="Student Management System"
