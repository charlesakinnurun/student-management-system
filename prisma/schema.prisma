// SMS Prisma schema — SQLite (dev) / PostgreSQL (prod) via DATABASE_URL.
//
// IMPORTANT — portable schema rules (see docs/ARCHITECTURE.md [D-9]):
//  * SQLite does not support native Prisma enums, so status/role/type columns
//    are stored as `String` and their allowed values are enforced in the
//    application layer (Zod schemas + TypeScript unions in `lib/domain/enums.ts`).
//    This keeps a single schema working on both SQLite and PostgreSQL.
//  * No provider-specific column types.
//
// All models use cuid string ids, timestamps and explicit referential actions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Allowed values (application-enforced):
//   User.role                    -> ADMIN | LECTURER | STUDENT
//   User.status                  -> ACTIVE | INACTIVE | SUSPENDED
//   StudentProfile.status        -> ACTIVE | COMPLETED | WITHDRAWN | PENDING
//   Enrollment.status            -> ACTIVE | COMPLETED | WITHDRAWN | PENDING
//   Assessment.type              -> ASSIGNMENT | TEST | QUIZ | MIDTERM | EXAM | PROJECT
//   Attendance.status            -> PRESENT | ABSENT | LATE | EXCUSED
//   Fee.status                   -> UNPAID | PARTIAL | PAID | OVERDUE

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String // ADMIN | LECTURER | STUDENT
  status       String   @default("ACTIVE") // ACTIVE | INACTIVE | SUSPENDED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?

  studentProfile StudentProfile?
  staffProfile   StaffProfile?
  auditLogs      AuditLog[]      @relation("AuditActor")
  announcements  Announcement[]  @relation("AnnouncementAuthor")

  @@index([role, status])
}

model Faculty {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  students    StudentProfile[]
}

model Department {
  id        String         @id @default(cuid())
  name      String
  code      String         @unique
  facultyId String
  faculty   Faculty        @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  programs  Program[]
  courses   Course[]
  staff     StaffProfile[]
  students  StudentProfile[]

  @@index([facultyId])
}

model Program {
  id           String         @id @default(cuid())
  name         String
  code         String         @unique
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  level        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  students     StudentProfile[]

  @@index([departmentId])
}

model AcademicSession {
  id          String             @id @default(cuid())
  name        String             @unique // e.g. "2025/2026"
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  semesters   Semester[]
  enrollments Enrollment[]
  assignments CourseAssignment[]
  fees        Fee[]

  @@index([isCurrent])
}

model Semester {
  id        String          @id @default(cuid())
  name      String // e.g. "First Semester"
  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  courses   Course[]
  enrollments Enrollment[]

  @@unique([sessionId, name])
  @@index([sessionId, isCurrent])
}

model StudentProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId        String   @unique // e.g. STU-2026-0001
  firstName        String
  lastName         String
  phone            String?
  dateOfBirth      DateTime?
  gender           String?
  address          String?
  photoUrl         String?
  facultyId        String?
  faculty          Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  programId        String?
  program          Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  level            String?
  sessionId        String?
  admissionDate    DateTime @default(now())
  status           String   @default("ACTIVE") // ACTIVE | COMPLETED | WITHDRAWN | PENDING
  emergencyContact String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?
  updatedBy        String?
  enrollments      Enrollment[]
  fees             Fee[]

  @@index([departmentId, level, status])
  @@index([lastName, firstName])
}

model StaffProfile {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId      String             @unique
  firstName    String
  lastName     String
  phone        String?
  departmentId String?
  department   Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  assignments  CourseAssignment[]
  scoresEntered Score[]           @relation("ScoreEnteredBy")

  @@index([departmentId])
}

model Course {
  id           String             @id @default(cuid())
  code         String
  title        String
  description  String?
  creditUnits  Int                @default(3)
  departmentId String
  department   Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  level        String?
  venue        String? // e.g. "LT-1"
  scheduleDays String? // e.g. "MON,WED"
  startTime    String? // "09:00"
  endTime      String? // "11:00"
  semesterId   String?
  semester     Semester?          @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  assignments  CourseAssignment[]
  assessments  Assessment[]
  enrollments  Enrollment[]

  @@unique([code, semesterId])
  @@index([departmentId, semesterId])
  @@index([level])
}

model CourseAssignment {
  id        String          @id @default(cuid())
  courseId  String
  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  staffId   String
  staff     StaffProfile    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([courseId, staffId, sessionId])
  @@index([staffId, sessionId])
  @@index([courseId, sessionId])
}

model Enrollment {
  id         String          @id @default(cuid())
  studentId  String
  student    StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  sessionId  String
  session    AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  // semesterId is required: an enrolment always belongs to a term. It is also
  // part of the uniqueness key, and a nullable column would let duplicate
  // enrolments slip through (NULLs are distinct in unique indexes).
  semesterId String
  semester   Semester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  status     String          @default("ACTIVE") // ACTIVE | COMPLETED | WITHDRAWN | PENDING
  enrolledAt DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  scores     Score[]
  attendance Attendance[]

  // Prevents duplicate enrolment at the database level.
  @@unique([studentId, courseId, sessionId, semesterId])
  @@index([studentId, status])
  @@index([courseId, sessionId])
}

model Assessment {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type        String // ASSIGNMENT | TEST | QUIZ | MIDTERM | EXAM | PROJECT
  title       String
  maxScore    Float
  weight      Float // percent contribution to course total (0-100)
  dueDate     DateTime?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  scores      Score[]

  @@index([courseId, isPublished])
}

model Score {
  id           String       @id @default(cuid())
  assessmentId String
  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  rawScore     Float
  enteredById  String?
  enteredBy    StaffProfile? @relation("ScoreEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  history      GradeHistory[]

  @@unique([assessmentId, enrollmentId])
  @@index([enrollmentId])
}

model GradeHistory {
  id        String   @id @default(cuid())
  scoreId   String
  score     Score    @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  oldScore  Float
  newScore  Float
  changedBy String
  reason    String?
  createdAt DateTime @default(now())

  @@index([scoreId, createdAt])
}

// Configurable grading rules — NOT hardcoded. Ordered score bands per grading set.
model GradingRule {
  id        String   @id @default(cuid())
  setName   String   @default("default")
  minScore  Float
  maxScore  Float
  grade     String // e.g. A, B, C
  points    Float // grade points for GPA
  createdAt DateTime @default(now())

  @@unique([setName, grade])
  @@index([setName, minScore])
}

model Attendance {
  id           String   @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date         DateTime
  status       String // PRESENT | ABSENT | LATE | EXCUSED
  markedBy     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // One attendance record per student per day; making it idempotent.
  @@unique([enrollmentId, date])
  @@index([enrollmentId, date])
  @@index([date, status])
}

model Fee {
  id         String          @id @default(cuid())
  studentId  String
  student    StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId  String
  session    AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  amountDue  Float
  amountPaid Float           @default(0)
  status     String          @default("UNPAID") // UNPAID | PARTIAL | PAID | OVERDUE
  dueDate    DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  payments   Payment[]

  @@unique([studentId, sessionId])
  @@index([sessionId, status])
}

model Payment {
  id         String   @id @default(cuid())
  feeId      String
  fee        Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  amount     Float
  method     String?
  reference  String?  @unique
  paidAt     DateTime @default(now())
  recordedBy String?

  @@index([feeId, paidAt])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  audience    String   @default("ALL") // ALL | ADMIN | LECTURER | STUDENT
  courseId    String?
  departmentId String?
  authorId    String
  author      User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([audience, publishedAt])
  @@index([courseId])
}

// Append-only audit log.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. student.create, enrollment.update, grade.change, auth.login
  resource   String // e.g. StudentProfile, Enrollment, Score
  resourceId String?
  metadata   String? // JSON string
  createdAt  DateTime @default(now())

  @@index([resource, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
